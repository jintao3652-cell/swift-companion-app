<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette: deep avionics dark + cyan accent ============ -->
    <Color x:Key="BgColor">#FF0B0E14</Color>        <!-- app background, near-black blue -->
    <Color x:Key="TopbarColor">#FF11151F</Color>    <!-- top tab bar -->
    <Color x:Key="CardColor">#FF161B26</Color>      <!-- card surface -->
    <Color x:Key="CardHiColor">#FF1B2230</Color>    <!-- raised/hover surface -->
    <Color x:Key="AccentColor">#FF22D3EE</Color>    <!-- avionics cyan -->
    <Color x:Key="Accent2Color">#FF38BDF8</Color>   <!-- sky blue -->
    <Color x:Key="TextColor">#FFEAF0F7</Color>
    <Color x:Key="MutedColor">#FF7C8699</Color>
    <Color x:Key="LineColor">#1AFFFFFF</Color>      <!-- faint hairline border -->

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="TopbarBrush" Color="{StaticResource TopbarColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHiBrush" Color="{StaticResource CardHiColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="#FF34D399" />
    <SolidColorBrush x:Key="ErrBrush" Color="#FFFB7185" />

    <!-- Accent gradient for the brand mark / primary button -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <!-- Soft drop shadow for cards -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="6"
                      Direction="270" Opacity="0.35" Color="#FF000000" />

    <!-- ============ Top tab button (underline indicator) ============ -->
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" Margin="18,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="ind" Grid.Row="1" Margin="14,0"
                                Background="{StaticResource AccentGradient}"
                                CornerRadius="2" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="ind" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Primary button (accent gradient) ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF071018" />
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF2A3340" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Ghost button (outlined) ============ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource LineBrush}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource CardHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Card container ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

</ResourceDictionary>

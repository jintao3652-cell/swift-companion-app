<Window x:Class="SwiftCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SwiftCompanion.Desktop.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="SwiftCompanion" Height="640" Width="960"
        Icon="Assets/SwiftCompanion.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- System tray icon: double-click reopens; right-click menu shows/exits. -->
        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="Assets/SwiftCompanion.ico"
                        ToolTipText="{DynamicResource L.Tray.Tooltip}"
                        TrayMouseDoubleClick="Tray_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource L.Tray.Show}" Click="TrayShow_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.Tray.Exit}" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ===== Top bar: brand + tabs ===== -->
        <Border Grid.Row="0" Background="{StaticResource TopbarBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                  Opacity="0.4" Color="#FF000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="22,0,28,0"
                            VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{StaticResource AccentGradient}">
                        <TextBlock Text="◆" FontSize="15" Foreground="#FF071018"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SwiftCompanion" FontSize="17" FontWeight="Bold"
                               Margin="11,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton x:Name="NavHome" Style="{StaticResource TopTab}"
                                 Content="{DynamicResource L.Tab.Home}" IsChecked="True" Checked="Nav_Checked" Tag="Home" />
                    <RadioButton x:Name="NavPair" Style="{StaticResource TopTab}"
                                 Content="{DynamicResource L.Tab.Pair}" Checked="Nav_Checked" Tag="Pair" />
                    <RadioButton x:Name="NavChat" Style="{StaticResource TopTab}"
                                 Content="{DynamicResource L.Tab.Chat}" Checked="Nav_Checked" Tag="Chat" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource TopTab}"
                                 Content="{DynamicResource L.Tab.Settings}" Checked="Nav_Checked" Tag="Settings" />
                </StackPanel>

                <!-- Language toggle + version -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Button x:Name="LangButton" Style="{StaticResource GhostButton}"
                            Height="30" Padding="12,0" Click="LangButton_Click"
                            Content="中 / EN" FontSize="12" Margin="0,0,14,0" />
                    <TextBlock Text="v1.0.0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <ContentControl Grid.Row="1" x:Name="ContentHost">
            <views:HomeView />
        </ContentControl>
    </Grid>
</Window>

<UserControl x:Class="SwiftCompanion.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource L.Chat.Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{DynamicResource L.Chat.Subtitle}"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>

        <!-- Status row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <Grid Width="12" Height="12" VerticalAlignment="Center">
                <Ellipse Fill="{Binding StatusColor}" Opacity="0.3" />
                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" Margin="9,0,0,0" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource L.Chat.Reload}" Style="{StaticResource GhostButton}"
                    Height="26" Padding="10,0" FontSize="12" Margin="14,0,0,0"
                    Command="{Binding ReloadCommand}" />
        </StackPanel>

        <!-- Messages -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListBox x:Name="MessagesList" ItemsSource="{Binding Messages}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="14,5,14,5" MaxWidth="520"
                                CornerRadius="10" Padding="11,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BgBrush}" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding ShowSender}">
                                    <Border Background="{StaticResource BgBrush}" CornerRadius="5"
                                            Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent2Brush}" />
                                    </Border>
                                    <Border Background="Transparent" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeTag}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                           Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF071018" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Composer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModeCombo" Grid.Column="0" SelectedIndex="0" Width="96" Height="32"
                      VerticalContentAlignment="Center"
                      SelectionChanged="Mode_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource L.Chat.ModeRadio}" />
                <ComboBoxItem Content="{DynamicResource L.Chat.ModePrivate}" />
            </ComboBox>
            <TextBox Grid.Column="1" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding RecipientVisibility}"
                     Width="130" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="{DynamicResource L.Chat.RecipientHint}" />
            <TextBox Grid.Column="2" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" Margin="8,0,8,0" VerticalContentAlignment="Center"
                     KeyDown="Input_KeyDown" />
            <Button Grid.Column="3" Content="{DynamicResource L.Btn.Send}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" MinWidth="78" />
        </Grid>
    </Grid>
</UserControl>

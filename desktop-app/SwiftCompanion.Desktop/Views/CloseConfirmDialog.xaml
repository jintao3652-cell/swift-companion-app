<Window x:Class="SwiftCompanion.Desktop.Views.CloseConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwiftCompanion" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="{DynamicResource L.Close.Title}" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <TextBlock Text="{DynamicResource L.Close.Body}" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,18" />

            <CheckBox x:Name="RememberBox" Content="{DynamicResource L.Close.Remember}"
                      Foreground="{StaticResource MutedBrush}" FontSize="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="ExitBtn" Content="{DynamicResource L.Close.Exit}"
                        Style="{StaticResource GhostButton}" Click="Exit_Click" Margin="0,0,12,0" />
                <Button x:Name="HideBtn" Content="{DynamicResource L.Close.HideToTray}"
                        Style="{StaticResource PrimaryButton}" Click="Hide_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="SwiftCompanion.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SwiftCompanion.Desktop.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource L.Home.Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{DynamicResource L.Home.Subtitle}"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,22" />

            <!-- ===== Status hero card ===== -->
            <Border Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource L.Home.BridgeService}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding StatusColor}" Opacity="0.3" />
                                <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" />
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0"
                                       FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource L.Btn.Start}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                                Margin="0,0,10,0" />
                        <Button Content="{DynamicResource L.Btn.Stop}" Style="{StaticResource GhostButton}"
                                Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                                Margin="0,0,10,0" />
                        <Button Content="{DynamicResource L.Btn.Restart}" Style="{StaticResource GhostButton}"
                                Command="{Binding RestartCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Connection info card ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Home.ConnInfo}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.Home.LocalUrl}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                                CornerRadius="8" Padding="12,7" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LocalUrl}" FontFamily="Consolas"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.Home.NetworkUrl}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                                CornerRadius="8" Padding="12,7" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LanUrl}" FontFamily="Consolas"
                                       Foreground="{StaticResource Accent2Brush}" />
                        </Border>
                    </Grid>

                    <!-- Public (tunnel) URL — only visible while the Cloudflare tunnel is up. -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding PublicUrlVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.Home.PublicUrl}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                                CornerRadius="8" Padding="12,7" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PublicUrl}" FontFamily="Consolas"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource L.Home.Tip}"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

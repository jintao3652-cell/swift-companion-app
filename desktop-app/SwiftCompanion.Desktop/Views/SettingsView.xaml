<UserControl x:Class="SwiftCompanion.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource L.Settings.Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{DynamicResource L.Settings.Subtitle}"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,22" />

            <!-- ===== vPilot plugin settings: not applicable to swift (DBus direct) ===== -->
            <Border Style="{StaticResource Card}" Padding="26" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Settings.Vpilot}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Settings.VpilotPort}" Width="130"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding VpilotPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110" FontFamily="Consolas" FontSize="14"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource AccentBrush}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                        <Button Content="{DynamicResource L.Btn.Save}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.Settings.PortHint}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="130,10,0,0" />

                    <!-- vPilot.exe path -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource L.Settings.VpilotPath}" Width="130"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding VpilotPath, UpdateSourceTrigger=PropertyChanged}"
                                     Width="360" FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                        <Button Content="{DynamicResource L.Settings.Browse}" Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.Settings.PathHint}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="130,10,0,0" />

                    <TextBlock Text="{Binding Hint}" Foreground="{Binding HintColor}"
                               FontSize="12" Margin="130,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Self-hosted relay (frp) ===== -->
            <Border Style="{StaticResource Card}" Padding="26" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Settings.Relay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource L.Settings.Relay.Desc}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14" />
                    <CheckBox IsChecked="{Binding RelayEnabled}"
                              Content="{DynamicResource L.Settings.Relay.Enable}"
                              Foreground="{StaticResource TextBrush}" FontSize="14" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock Text="{DynamicResource L.Settings.Relay.Server}" Width="130"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding RelayServerAddr, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260" FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource TextBrush}"
                                     IsEnabled="{Binding RelayEnabled}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource L.Settings.Relay.ServerPort}" Margin="24,0,10,0"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding RelayServerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource TextBrush}"
                                     IsEnabled="{Binding RelayEnabled}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource L.Settings.Relay.Token}" Width="130"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding RelayToken, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260" FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource TextBrush}"
                                     IsEnabled="{Binding RelayEnabled}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource L.Settings.Relay.RemotePort}" Margin="24,0,10,0"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="2"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBox Text="{Binding RelayRemotePort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" FontFamily="Consolas" FontSize="13"
                                     Background="Transparent" BorderThickness="0" Padding="10,7"
                                     Foreground="{StaticResource TextBrush}"
                                     IsEnabled="{Binding RelayEnabled}"
                                     CaretBrush="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <Button Content="{DynamicResource L.Settings.Relay.Apply}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyRelayCommand}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding RelayStatus}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== General ===== -->
            <Border Style="{StaticResource Card}" Padding="26">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Settings.General}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                    <CheckBox IsChecked="{Binding RunAtStartup}"
                              Content="{DynamicResource L.Settings.RunStartup}"
                              Foreground="{StaticResource TextBrush}" FontSize="14" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource L.Settings.CloseBehavior}" Width="170"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <ComboBox Width="180" SelectedIndex="{Binding CloseBehaviorIndex}">
                            <ComboBoxItem Content="{DynamicResource L.Settings.Close.Ask}" />
                            <ComboBoxItem Content="{DynamicResource L.Settings.Close.HideToTray}" />
                            <ComboBoxItem Content="{DynamicResource L.Settings.Close.Exit}" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

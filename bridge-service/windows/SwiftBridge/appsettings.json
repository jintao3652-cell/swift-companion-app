{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Port": "5000",
  "Bridge": {
    "EnableMdns": true,
    "ServiceName": "swift Companion Bridge"
  },
  "Jwt": {
    "SecretKey": "SwiftCompanion_SecretKey_ChangeThis_InProduction_32Chars_Minimum!",
    "Issuer": "SwiftCompanionBridge",
    "Audience": "SwiftCompanionApp",
    "ExpirationMinutes": "1440"
  },
  "PushNotification": {
    "FcmServerKey": "YOUR_FCM_SERVER_KEY_HERE",
    "EnablePush": true
  },
  "Swift": {
    "Simulate": "false",
    "Address": "tcp:host=127.0.0.1,port=45000",
    "PollMs": "1000"
  }
}